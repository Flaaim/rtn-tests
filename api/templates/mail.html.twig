<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html lang="ru" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{% block title %}RTN-TESTS.RU{% endblock %}</title>
    <style type="text/css">
        /* Используем стек шрифтов shadcn (Inter / системные) */
        body { margin: 0; padding: 0; min-width: 100%; font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; -webkit-font-smoothing: antialiased; }
        table { border-collapse: collapse; border-spacing: 0; }
    </style>
</head>
<body style="background-color: #f8fafc; margin: 0; padding: 0;">

<span style="display:none;font-size:1px;color:#333333;line-height:1px;max-height:0px;max-width:0px;opacity:0;overflow:hidden;">
    {% block preheader %}Важное уведомление{% endblock %}
</span>

<table cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8fafc; padding: 40px 0; width: 100%;">
    <tr>
        <td align="center">
            <!-- Карточка в стиле shadcn Card -->
            <table cellpadding="0" cellspacing="0" style="max-width: 600px; width: 100%; background-color: #ffffff; border-radius: 8px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);">
                <tr>
                    <td style="padding: 24px 32px; border-bottom: 1px solid #e2e8f0; text-align: left;">
                        <span style="color: #0f172a; font-size: 18px; font-weight: 600; letter-spacing: -0.02em;">
                            RTN-TESTS.RU
                        </span>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 32px; font-size: 15px; line-height: 1.6; color: #334155;">
                        {% block body %}{% endblock %}
                    </td>
                </tr>
                <tr>
                    <td style="background-color: #f8fafc; padding: 24px 32px; text-align: left; border-top: 1px solid #e2e8f0;">
                        <p style="margin: 0; font-size: 13px; color: #64748b; line-height: 1.5;">
                            Вы получили это письмо, так как этот адрес был указан при регистрации.<br>
                            Если вы не отправляли запрос, просто проигнорируйте это сообщение.
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
